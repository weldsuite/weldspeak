{
  "name": "@weldspeak/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply weldspeak --local",
    "db:migrate": "wrangler d1 migrations apply weldspeak --remote",
    "test:stream": "node --experimental-strip-types scripts/stream-wav.ts",
    "pretest": "node -e \"require('fs').mkdirSync('../../apps/web/dist',{recursive:true})\"",
    "predev": "node -e \"require('fs').mkdirSync('../../apps/web/dist',{recursive:true})\""
  },
  "dependencies": {
    "@clerk/backend": "^2.0.0",
    "hono": "^4.6.14",
    "svix": "^1.45.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260908.1",
    "@weldspeak/protocol": "workspace:*",
    "typescript": "^5.9.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.130.0",
    "vite": "^7.0.0",
    "@types/node": "^22.10.0"
  }
}
