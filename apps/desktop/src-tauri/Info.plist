<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Shown verbatim in the macOS permission prompt. Say what it is for in the
       user's terms: a vague string here is a common reason people decline. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>WeldSpeak listens while you hold the dictation key, so it can turn what you say into text.</string>

  <!-- Tray-only application: no dock icon, no main window. -->
  <key>LSUIElement</key>
  <true/>
</dict>
</plist>
