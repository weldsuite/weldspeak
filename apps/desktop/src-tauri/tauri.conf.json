{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WeldSpeak",
  "version": "0.1.0",
  "identifier": "io.weldspeak.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter @weldspeak/desktop-ui dev",
    "beforeBuildCommand": "pnpm --filter @weldspeak/desktop-ui build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "settings",
        "title": "WeldSpeak",
        "width": 480,
        "height": 720,
        "resizable": true,
        "visible": true
      },
      {
        "label": "overlay",
        "url": "index.html",
        "width": 420,
        "height": 64,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "WeldSpeak"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
