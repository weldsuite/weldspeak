{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the native tray app.",
  "windows": [],
  "permissions": [
    "core:default",
    "core:event:default",
    "global-shortcut:default",
    "updater:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    }
  ]
}
