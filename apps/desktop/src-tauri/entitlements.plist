<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Microphone access. Without this the hardened runtime denies capture
       outright and the app records silence with no visible error. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>

  <!-- The dictation WebSocket and the token endpoints. -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
